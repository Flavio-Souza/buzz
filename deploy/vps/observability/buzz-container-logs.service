[Unit]
Description=Mirror Buzz Docker logs into journald
Requires=docker.service buzz-vps.service
After=docker.service buzz-vps.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/iaquant/LAB/buzz/deploy/vps
ExecStart=/usr/bin/docker compose --env-file .env -f compose.yaml logs --follow --no-color --timestamps relay minio minio-init
Restart=always
RestartSec=5
SyslogIdentifier=buzz-container-logs
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
