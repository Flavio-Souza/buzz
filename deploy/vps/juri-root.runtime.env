# Non-secret runtime policy for Juri Root. Loaded after agent.env so these
# deployment-owned settings override legacy values in the private identity file.
BUZZ_ACP_AGENT_COMMAND=/opt/buzz-agent-runtime/bin/codex-acp
# codex-acp uses read-only/agent/agent-full-access; buzz-acp's default
# bypassPermissions value is a Claude mode and is ignored by this adapter.
INITIAL_AGENT_MODE=agent-full-access
BUZZ_ACP_RELAY_OBSERVER=true
BUZZ_ACP_MODEL=gpt-5.6-luna
BUZZ_ACP_EFFORT_LEVEL=max
BUZZ_ACP_BASE_PROMPT_FILE=/srv/buzz-agents/juri-root/base-prompt.md
