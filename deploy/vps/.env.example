# Copy to deploy/vps/.env and set stable secrets. This file is ignored by Git.

BUZZ_IMAGE=ghcr.io/block/buzz:main
BUZZ_BIND_HOST=10.20.0.1
# Buzz port family is 33xx; 3300 is the VPN-facing relay and web port.
# 3000 remains the internal container port expected by the Buzz image.
BUZZ_BIND_ADDR=0.0.0.0:3000
BUZZ_HTTP_PORT=3300
BUZZ_HEALTH_PORT=8080
BUZZ_METRICS_PORT=9102
BUZZ_GIT_DATA_DIR=/home/ubuntu/iaquant/LAB/buzz/deploy/vps/data/git
BUZZ_GIT_REPO_PATH=/data/git

RELAY_URL=ws://10.20.0.1:3300
BUZZ_DOMAIN=10.20.0.1:3300
BUZZ_MEDIA_BASE_URL=http://10.20.0.1:3300/media
BUZZ_MEDIA_SERVER_DOMAIN=10.20.0.1:3300
BUZZ_CORS_ORIGINS=http://10.20.0.1:3300,tauri://localhost,http://tauri.localhost

BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
BUZZ_SERVE_GIT_WEB_GUI=true
BUZZ_PUSH_ENABLED=false
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

# Docker keeps local JSON logs bounded. These defaults apply to the relay,
# MinIO, and the optional observability stack.
BUZZ_DOCKER_LOG_MAX_SIZE=50m
BUZZ_DOCKER_LOG_MAX_FILES=5

# Optional relay tracing. Leave the endpoint unset when the observability stack
# is disabled. Uncomment it when Tempo is running on the private Compose network.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_SERVICE_NAME=buzz-relay
BUZZ_OTEL_FILTER=buzz_relay=info,buzz_datastore=info

# Optional observability overlay. Only Prometheus and Grafana are published,
# both on the WireGuard address. Loki, Tempo, and Alloy remain private.
BUZZ_PROMETHEUS_IMAGE=prom/prometheus:v3.5.0@sha256:63805ebb8d2b3920190daf1cb14a60871b16fd38bed42b857a3182bc621f4996
BUZZ_GRAFANA_IMAGE=grafana/grafana:12.1.0@sha256:6ac590e7cabc2fbe8d7b8fc1ce9c9f0582177b334e0df9c927ebd9670469440f
BUZZ_LOKI_IMAGE=grafana/loki:3.5.3@sha256:3165cecce301ce5b9b6e3530284b080934a05cd5cafac3d3d82edcb887b45ecd
BUZZ_TEMPO_IMAGE=grafana/tempo:2.8.2@sha256:0ef775495967cd5d7a6b2e146b6ea695d624803c8db8349fb8ce4164f719f9b7
BUZZ_ALLOY_IMAGE=grafana/alloy:v1.10.1@sha256:582f5a5169cd67a2bdbf98777c1a6f596203f573cdef5c021749fd3279605768
BUZZ_PROMETHEUS_PORT=3310
BUZZ_GRAFANA_PORT=3311
BUZZ_PROMETHEUS_RETENTION=15d
BUZZ_PROMETHEUS_RETENTION_SIZE=5GB
# External network created by the `buzz-vps` Compose project.
BUZZ_DOCKER_NETWORK=buzz-vps_buzz-net
# Host GID returned by: getent group systemd-journal
BUZZ_SYSTEMD_JOURNAL_GID=999
BUZZ_SYSTEMD_ADM_GID=4
BUZZ_GRAFANA_ADMIN_USER=admin
# Generate with: openssl rand -base64 36
BUZZ_GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_GRAFANA_PASSWORD

RELAY_OWNER_PUBKEY=REPLACE_WITH_OWNER_PUBLIC_KEY
BUZZ_RELAY_PRIVATE_KEY=REPLACE_WITH_STABLE_RELAY_PRIVATE_KEY
BUZZ_GIT_HOOK_HMAC_SECRET=REPLACE_WITH_RANDOM_SECRET

# Existing Postgres on db. The database and role must be dedicated to Buzz.
DATABASE_URL=postgres://buzz:REPLACE_WITH_POSTGRES_PASSWORD@10.20.0.3:5432/buzz
# Existing Redis on db. This ACL user is restricted to the buzz:* namespace.
REDIS_URL=redis://buzz:REPLACE_WITH_REDIS_PASSWORD@10.20.0.3:6379/0

# MinIO is the S3-compatible store used by the official Buzz Compose layout.
BUZZ_S3_DATA_DIR=/home/ubuntu/iaquant/LAB/buzz/deploy/vps/data/minio
BUZZ_S3_ENDPOINT=http://minio:9000
BUZZ_S3_REGION=us-east-1
BUZZ_S3_ADDRESSING_STYLE=path
BUZZ_S3_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
BUZZ_S3_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
BUZZ_S3_BUCKET=buzz-media
