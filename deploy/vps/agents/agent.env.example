# Copy this directory to agents/<name>, then copy this file to agent.env.
# Keep agent.env mode 0600. Use one Nostr identity per agent.
AGENT_NAME=assistente
AGENT_DIR=/home/ubuntu/iaquant/LAB/buzz/deploy/vps/agents/assistente
BUZZ_RELAY_URL=ws://10.20.0.1:3300
BUZZ_PRIVATE_KEY=REPLACE_WITH_AGENT_PRIVATE_KEY
BUZZ_ACP_AGENT_OWNER=9309076b64de8b9a05dbece03e444b7fb5cf2def77d5850eee276396a20e4a89
BUZZ_ACP_RESPOND_TO=owner-only
BUZZ_ACP_AGENT_COMMAND=codex-acp
BUZZ_ACP_AGENT_ARGS=
BUZZ_ACP_MCP_COMMAND=/home/ubuntu/iaquant/LAB/buzz/.local/sprig/buzz-dev-mcp
BUZZ_ACP_SYSTEM_PROMPT_FILE=/home/ubuntu/iaquant/LAB/buzz/deploy/vps/agents/assistente/instructions.md
BUZZ_ACP_SESSION_TITLE=assistente
BUZZ_ACP_EXIT_AFTER_INACTIVITY=0

# Runtime options:
#   Codex: BUZZ_ACP_AGENT_COMMAND=codex-acp
#   Claude Code: BUZZ_ACP_AGENT_COMMAND=claude-agent-acp
# These adapters are installed in /home/ubuntu/.local/bin by the setup.
